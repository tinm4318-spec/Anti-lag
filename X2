                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Text = string.upper(name)
                lbl.LayoutOrder = 1

                local btnRow = Instance.new("Frame", row)
                btnRow.Size = UDim2.new(1, 0, 0, 26)
                btnRow.BackgroundTransparency = 1
                btnRow.LayoutOrder = 2
                local bLayout = Instance.new("UIListLayout", btnRow)
                bLayout.FillDirection = Enum.FillDirection.Horizontal
                bLayout.Padding = UDim.new(0, 6)

                local active = defaultMode or modes[1]
                local modeButtons = {}
                local function Refresh()
                    for m, data in pairs(modeButtons) do
                        local isAct = (m == active)
                        data.Btn.BackgroundColor3 = isAct and Theme.Accent or Theme.SubBox
                        data.Btn.TextColor3 = isAct and Color3.new(1, 1, 1) or Theme.TextDim
                    end
                end
                for _, m in ipairs(modes) do
                    local b = Instance.new("TextButton", btnRow)
                    b.Size = UDim2.new(1 / #modes, -((#modes - 1) * 6) / #modes, 1, 0)
                    b.Text = m
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = 9.5
                    b.TextScaled = true
                    b.AutoButtonColor = false
                    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
                    modeButtons[m] = { Btn = b }
                    b.MouseButton1Click:Connect(function()
                        PlaySound("Click")
                        active = m
                        Refresh()
                        pcall(callback, m)
                    end)
                end
                Refresh()
                table.insert(ThemeRegistry.ModeSelectors, Refresh)
            end

            return BoxObj
        end

        return TabObj
    end

    return WindowObj
end

getgenv().StarHubUI = StarHubUI
_G.StarHubUI = StarHubUI

return StarHubUI
